{
  "_comment": "Director tieu het TP_budget(R,G) theo composition. weight = ti le TP phan bo cho loai do.",
  "directorRules": {
    "tpFormula": "round((14 + 4.2*R) * (1 + 0.18*(w-1)) * roomTypeMult)  -- w = wave trong phong. KHONG co dial nguoi choi.",
    "roomTypeMult": { "combat": 1.00, "elite": 1.40, "gauntlet": 2.20, "boss": 1.60 },
    "waveDelayAfterClearSec": [1.5, 2.0],
    "firstWaveDelaySec": 0.4,
    "roomClearSlowMo": { "durationSec": 0.35, "timescale": 0.4 },
    "hardCaps": {
      "maxFullAiAgents": 40,
      "maxTotalAlive": 240,
      "maxSimultaneousShooters": 3,
      "maxExploderInMeleeBand": 2,
      "maxEliteOutsideEliteRoom": 1,
      "maxDistinctTypesPerWave": 4,
      "newEnemyTypesPerRoom": 1
    },
    "blackMist": {
      "triggerSec": 35, "triggerSecDeep": 28, "deepRoomThreshold": 8,
      "vignetteStepPercent": 6, "vignetteStepSec": 5,
      "spawnEnemy": "en_special_bongham", "spawnIntervalSec": 4,
      "exemptRooms": ["boss", "shop", "shrine"]
    },
    "tpSpikeLimit": 1.8,
    "spawnPatterns": {
      "_comment": "spawnDistM = khoang cach truoc mat nguoi choi luc spawn. Quai DUNG YEN nen toc do tiep can = toc do chay, vi vay day chinh la cua so phan ung. Audit gate: min >= tapNearM + minReactionSec * speedMps. lane: mixed = theo lanes.midSpawnFrac, sides = chi hai lan ben.",
      "front_stream": { "desc": "Tới đều từ chính giữa dải Xa", "spawnDistM": [12, 21], "lane": "mixed" },
      "pincer": { "desc": "Dồn cả hai làn bên, để trống làn giữa", "spawnDistM": [12, 21], "lane": "sides" },
      "rush_line": { "desc": "Một hàng ngang, cùng lúc", "spawnDistM": [16, 18], "lane": "mixed" },
      "back_ambush": { "desc": "Hiện ra sát trước mặt — cảnh báo ngắn nhất còn hợp lệ", "spawnDistM": [9, 12], "lane": "mixed" },
      "ceiling_drop": { "desc": "Thả từ trần xuống dải Giữa", "spawnDistM": [9, 14], "lane": "mixed" },
      "far_static": { "desc": "Đứng yên ở dải Xa", "spawnDistM": [17, 21], "lane": "mixed" },
      "flood": { "desc": "Spawn liên tục, dày nhất", "spawnDistM": [11, 22], "lane": "mixed" }
    }
  },
